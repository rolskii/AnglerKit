{
  "name": "Reel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Reel name/description"
    },
    "species": {
      "type": "string",
      "enum": [
        "Trout",
        "Salmon",
        "Steelhead",
        "Bass",
        "Pike",
        "Saltwater",
        "Gar",
        "Muskie",
        "Anything",
        "Other"
      ]
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Casting",
        "Fly",
        "Spinning",
        "Other"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "value": {
      "type": "number",
      "description": "Dollar value of the reel"
    },
    "date_acquired": {
      "type": "string",
      "format": "date",
      "description": "Date the reel was acquired"
    },
    "image_url": {
      "type": "string",
      "description": "Legacy single photo (superseded by images)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the reel"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial number of the reel"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}