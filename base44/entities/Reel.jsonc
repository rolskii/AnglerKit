{
  "name": "Reel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Reel name/description"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "image_url": {
      "type": "string",
      "description": "Photo of the reel"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}