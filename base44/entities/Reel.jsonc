{
  "name": "Reel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Reel name/description"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Baitcaster",
        "Fly",
        "Spinning",
        "Other"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "value": {
      "type": "number",
      "description": "Dollar value of the reel"
    },
    "image_url": {
      "type": "string",
      "description": "Legacy single photo (superseded by images)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the reel"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}