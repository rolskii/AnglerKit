{
  "name": "Rod",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Rod name/description"
    },
    "brand": {
      "type": "string"
    },
    "length": {
      "type": "string"
    },
    "line_weight": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Baitcasting",
        "Fly",
        "Spinning",
        "Other"
      ]
    },
    "material": {
      "type": "string",
      "enum": [
        "Carbon",
        "Cane",
        "Fiberglass",
        "Other"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "value": {
      "type": "number",
      "description": "Dollar value of the rod"
    },
    "image_url": {
      "type": "string",
      "description": "Legacy single photo (superseded by images)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the rod"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}