{
  "name": "Supply",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supply name/description"
    },
    "category": {
      "type": "string",
      "enum": [
        "Leader/Tippet",
        "Weight",
        "Wire",
        "Hair",
        "Feathers",
        "Hooks",
        "Thread/Floss",
        "Beads/Eyes",
        "Dubbing",
        "Adhesive",
        "Indicator/Float",
        "Floatant/Dressing",
        "Other"
      ],
      "default": "Other",
      "description": "Type of fly/lure building material or on-stream consumable supply"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "description": "Model or size (e.g. #14, 0.030, 70 Denier, Sz 2)"
    },
    "colour": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "description": "How many of this item you own",
      "default": 1
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ],
      "default": "New"
    },
    "value": {
      "type": "number",
      "description": "Dollar value of the supply"
    },
    "date_acquired": {
      "type": "string",
      "format": "date",
      "description": "Date the supply was acquired"
    },
    "image_url": {
      "type": "string",
      "description": "Legacy single photo (superseded by images)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the supply"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}