{
  "name": "FlyLine",
  "type": "object",
  "properties": {
    "species": {
      "type": "string",
      "enum": [
        "Trout",
        "Salmon",
        "Steelhead",
        "Bass",
        "Pike",
        "Saltwater",
        "Gar",
        "Muskie",
        "Anything",
        "Other"
      ]
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Tip",
        "Body",
        "Head",
        "Integrated",
        "Shooting",
        "WF",
        "Running",
        "Sinking",
        "System",
        "Other"
      ]
    },
    "rod_type": {
      "type": "string",
      "enum": [
        "Casting",
        "Fly",
        "Spinning",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "line_weight": {
      "type": "string"
    },
    "grain_weight": {
      "type": "number"
    },
    "head_length": {
      "type": "number"
    },
    "total_length": {
      "type": "number"
    },
    "colour": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Brand New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "value": {
      "type": "number",
      "description": "Dollar value of the line"
    },
    "reel": {
      "type": "string",
      "description": "Reel this line is on"
    },
    "rod": {
      "type": "string",
      "description": "Rod this line is paired with"
    },
    "spooled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this line is on a spare spool (not on a reel)"
    },
    "date_acquired": {
      "type": "string",
      "format": "date",
      "description": "Date the line was acquired"
    },
    "image_url": {
      "type": "string",
      "description": "Legacy single photo (superseded by images)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the line"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "brand",
    "model"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}