{
  "name": "FlyLine",
  "type": "object",
  "properties": {
    "species": {
      "type": "string",
      "enum": [
        "Trout",
        "Salmon",
        "Steelhead",
        "Bass",
        "Pike",
        "Saltwater",
        "Gar",
        "Muskie",
        "Anything",
        "Other"
      ]
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Tip",
        "Body",
        "Head",
        "Integrated",
        "Shooting",
        "WF",
        "Running",
        "Sinking",
        "System",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "line_weight": {
      "type": "string"
    },
    "grain_weight": {
      "type": "number"
    },
    "head_length": {
      "type": "number"
    },
    "total_length": {
      "type": "number"
    },
    "colour": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Brand New",
        "Like New",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "reel": {
      "type": "string",
      "description": "Reel this line is on"
    },
    "rod": {
      "type": "string",
      "description": "Rod this line is paired with"
    },
    "spooled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this line is on a spare spool (not on a reel)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "brand",
    "model"
  ]
}