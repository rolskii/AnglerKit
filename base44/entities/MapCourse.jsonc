{
  "name": "MapCourse",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Route name"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the route"
    },
    "track": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "ts": {
            "type": "number",
            "description": "Unix timestamp in ms"
          }
        }
      },
      "description": "GPS track points recorded in real-time",
      "default": []
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "marker": {
            "type": "string",
            "enum": [
              "pin",
              "fish"
            ],
            "default": "pin",
            "description": "Marker type for this pin"
          }
        }
      },
      "description": "Points of interest with labels",
      "default": []
    },
    "drawings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string",
            "description": "Stroke color (hex)"
          },
          "label": {
            "type": "string",
            "description": "Optional title for the drawing"
          },
          "description": {
            "type": "string",
            "description": "Optional notes about the drawing"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "description": "Freehand drawing strokes with color and optional label/description",
      "default": []
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                }
              }
            }
          },
          "distance_km": {
            "type": "number",
            "description": "Total distance of this measurement in kilometers"
          }
        }
      },
      "description": "Saved distance measurements",
      "default": []
    },
    "distance_km": {
      "type": "number",
      "description": "Total distance travelled in kilometers",
      "default": 0
    },
    "duration_sec": {
      "type": "number",
      "description": "Total duration of the route in seconds",
      "default": 0
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the route was recorded"
    }
  },
  "required": [
    "name"
  ]
}