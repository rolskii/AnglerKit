{
  "name": "FishingAlarm",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the alarm is for"
    },
    "time": {
      "type": "string",
      "description": "Alarm time in 12-hour format (e.g., 2:30 PM)"
    },
    "offset": {
      "type": "number",
      "default": 0,
      "description": "Minutes before the feeding window to fire"
    },
    "fire_time": {
      "type": "string",
      "description": "ISO 8601 UTC datetime when the alarm should fire"
    },
    "location": {
      "type": "string",
      "description": "Location name for the alarm"
    },
    "fired": {
      "type": "boolean",
      "default": false,
      "description": "Whether the alarm has been fired"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the alarm is active"
    }
  },
  "required": [
    "date",
    "time",
    "fire_time"
  ]
}